<?xml version="1.0"?>
<!--
/**
 * Declarative schema for the Paymos module.
 *
 *   paymos_payment_event   — webhook dedup; event_id is the PRIMARY KEY so a
 *                            concurrent re-delivery loses the race on insert.
 *   paymos_payment_invoice — per-order invoice snapshot (amount/currency/project
 *                            at creation time) used by AmountGuard, the reverse
 *                            verifier and reconciliation.
 *
 * NOTE: the schema URN is "Setup/Declaration/Schema" (verified against core,
 * e.g. Magento/GiftMessage/etc/db_schema.xml) — not "Declarative".
 *
 * @see https://developer.adobe.com/commerce/php/development/components/declarative-schema/
 */
-->
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="paymos_payment_event" resource="default" engine="innodb" comment="Paymos processed webhook events (dedup)">
        <column xsi:type="varchar" name="event_id" nullable="false" length="128" comment="Paymos webhook event id (evt_...)"/>
        <column xsi:type="varchar" name="owner_token" nullable="false" length="32" default="" comment="Random owner token fencing commit/release to the delivery that reserved the row (A10-02)"/>
        <column xsi:type="int" name="expires_at" padding="10" unsigned="true" nullable="false" default="0" comment="Unix time the dedup row may be pruned (short reservation until commit, then full window)"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Row creation time"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="event_id"/>
        </constraint>
        <index referenceId="PAYMOS_PAYMENT_EVENT_EXPIRES_AT" indexType="btree">
            <column name="expires_at"/>
        </index>
    </table>

    <table name="paymos_payment_invoice" resource="default" engine="innodb" comment="Paymos invoice snapshot per order">
        <column xsi:type="int" name="entity_id" padding="10" unsigned="true" nullable="false" identity="true" comment="Row id"/>
        <column xsi:type="int" name="order_id" padding="10" unsigned="true" nullable="false" comment="Sales order entity id"/>
        <column xsi:type="varchar" name="order_increment_id" nullable="false" length="64" comment="Sales order increment id (external order id base)"/>
        <column xsi:type="varchar" name="external_order_id" nullable="false" length="128" comment="external_order_id sent to Paymos (with renew suffix)"/>
        <column xsi:type="varchar" name="paymos_invoice_id" nullable="false" length="128" comment="Paymos invoice id (inv_...)"/>
        <column xsi:type="varchar" name="environment" nullable="false" length="16" comment="sandbox|live"/>
        <column xsi:type="varchar" name="project_id" nullable="false" length="128" comment="Paymos project id"/>
        <column xsi:type="varchar" name="amount" nullable="false" length="64" comment="Order amount snapshot"/>
        <column xsi:type="varchar" name="currency" nullable="false" length="16" comment="Order currency snapshot"/>
        <column xsi:type="text" name="payment_url" nullable="false" comment="Hosted checkout URL"/>
        <column xsi:type="varchar" name="status" nullable="false" length="64" default="created" comment="Last known invoice status"/>
        <column xsi:type="int" name="renew_count" padding="10" unsigned="true" nullable="false" default="0" comment="Invoice renewals (amount-change bumps)"/>
        <column xsi:type="timestamp" name="created_at" on_update="false" nullable="false" default="CURRENT_TIMESTAMP" comment="Row creation time"/>
        <column xsi:type="timestamp" name="updated_at" on_update="true" nullable="false" default="CURRENT_TIMESTAMP" comment="Row update time"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="PAYMOS_PAYMENT_INVOICE_EXTERNAL_ORDER_ID">
            <column name="external_order_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="PAYMOS_PAYMENT_INVOICE_PAYMOS_INVOICE_ID">
            <column name="paymos_invoice_id"/>
        </constraint>
        <index referenceId="PAYMOS_PAYMENT_INVOICE_ORDER_ID" indexType="btree">
            <column name="order_id"/>
        </index>
    </table>
    <table name="paymos_refund_installation" resource="sales" engine="innodb" comment="Paymos refund installation">
        <column xsi:type="smallint" name="entity_id" unsigned="true" nullable="false" comment="entity_id"/>
        <column xsi:type="varchar" name="installation_id" length="36" nullable="false" comment="installation_id"/>
        <constraint xsi:type="primary" referenceId="PRIMARY"><column name="entity_id"/></constraint>
        <constraint xsi:type="unique" referenceId="PAYMOS_REFUND_INSTALLATION_UUID"><column name="installation_id"/></constraint>
    </table>
    <table name="paymos_refund_intent" resource="sales" engine="innodb" comment="Paymos committed refund intents">
        <column xsi:type="varchar" name="operation_id" length="36" nullable="false" comment="operation_id"/>
        <column xsi:type="varchar" name="installation_id" length="36" nullable="false" comment="installation_id"/>
        <column xsi:type="varchar" name="request_token" length="64" nullable="false" comment="request_token"/>
        <column xsi:type="varchar" name="payment_key" length="128" nullable="false" comment="payment_key"/>
        <column xsi:type="varchar" name="external_order_id" length="200" nullable="false" comment="external_order_id"/>
        <column xsi:type="varchar" name="withdrawal_id" length="128" nullable="true" comment="withdrawal_id"/>
        <column xsi:type="text" name="payload" nullable="false" comment="payload"/>
        <column xsi:type="bigint" name="created_at" unsigned="true" nullable="false" comment="created_at"/>
        <column xsi:type="bigint" name="next_due" unsigned="true" nullable="false" comment="next_due"/>
        <column xsi:type="int" name="poll_count" unsigned="true" nullable="false" default="0" comment="poll_count"/>
        <constraint xsi:type="primary" referenceId="PRIMARY"><column name="operation_id"/></constraint>
        <constraint xsi:type="unique" referenceId="PAYMOS_REFUND_INTENT_TOKEN"><column name="installation_id"/><column name="request_token"/></constraint>
        <constraint xsi:type="unique" referenceId="PAYMOS_REFUND_INTENT_EXTERNAL"><column name="external_order_id"/></constraint>
        <constraint xsi:type="unique" referenceId="PAYMOS_REFUND_INTENT_WITHDRAWAL"><column name="withdrawal_id"/></constraint>
        <index referenceId="PAYMOS_REFUND_INTENT_PAYMENT" indexType="btree"><column name="payment_key"/></index>
        <index referenceId="PAYMOS_REFUND_INTENT_DUE" indexType="btree"><column name="next_due"/><column name="operation_id"/></index>
    </table>
    <table name="paymos_refund_projection" resource="sales" engine="innodb" comment="Paymos native refund markers">
        <column xsi:type="varchar" name="operation_id" length="36" nullable="false" comment="operation_id"/>
        <column xsi:type="varchar" name="payment_key" length="128" nullable="false" comment="payment_key"/>
        <column xsi:type="text" name="result" nullable="false" comment="result"/>
        <constraint xsi:type="primary" referenceId="PRIMARY"><column name="operation_id"/></constraint>
    </table>
    <table name="sales_creditmemo" resource="sales" engine="innodb" comment="Sales Flat Creditmemo">
        <column xsi:type="varchar" name="paymos_refund_operation_id" nullable="true" length="36" comment="Paymos refund operation"/>
        <constraint xsi:type="unique" referenceId="SALES_CREDITMEMO_PAYMOS_REFUND_OPERATION"><column name="paymos_refund_operation_id"/></constraint>
    </table>
    <table name="sales_order_status_history" resource="sales" engine="innodb" comment="Sales Flat Order Status History">
        <column xsi:type="varchar" name="paymos_refund_operation_id" nullable="true" length="36" comment="Paymos cash note operation"/>
        <constraint xsi:type="unique" referenceId="SALES_ORDER_HISTORY_PAYMOS_REFUND_OPERATION"><column name="paymos_refund_operation_id"/></constraint>
    </table>
    <table name="paymos_refund_observation" resource="sales" engine="innodb" comment="Paymos unbound verified cash observations">
        <column xsi:type="varchar" name="withdrawal_id" nullable="false" length="128" comment="Provider refund id"/>
        <column xsi:type="varchar" name="payment_key" nullable="false" length="128" comment="Native payment key"/>
        <column xsi:type="text" name="payload" nullable="false" comment="Verified snapshot"/>
        <column xsi:type="varchar" name="history_id" nullable="true" length="64" comment="Cash note id"/>
        <column xsi:type="varchar" name="review_reason" nullable="true" length="128" comment="Review reason"/>
        <column xsi:type="bigint" name="next_due" nullable="false" unsigned="true" comment="Next read time"/>
        <constraint xsi:type="primary" referenceId="PRIMARY"><column name="withdrawal_id"/></constraint>
        <index referenceId="PAYMOS_REFUND_OBSERVATION_PAYMENT" indexType="btree"><column name="payment_key"/></index>
        <index referenceId="PAYMOS_REFUND_OBSERVATION_DUE" indexType="btree"><column name="next_due"/><column name="withdrawal_id"/></index>
    </table>
</schema>
